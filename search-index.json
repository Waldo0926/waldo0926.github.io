---
layout: null
permalink: /search-index.json
---
[
{%- for p in site.posts %}
  {
    "title": {{ p.title | jsonify }},
    "url": {{ p.url | relative_url | jsonify }},
    "description": {{ p.description | default: "" | jsonify }},
    "project": {{ p.project | default: "" | jsonify }},
    "lang": {{ p.lang | default: "en" | jsonify }},
    "date": {{ p.date | date: "%Y-%m-%d" | jsonify }},
    "content": {{ p.content | strip_html | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{%- endfor %}
]
